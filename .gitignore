# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# uv
# (uv.lock IS committed for reproducibility — do not ignore it)

# Env / secrets
.env

# Data (gitignored per README — corpora, indexes, eval caches).
# data/eval/ is deliberately NOT listed here: gold sets are versioned
# (docs/09-evaluation.md). Note git can't un-ignore a path whose parent
# directory is itself ignored, so list heavy subdirs individually instead
# of ignoring data/ wholesale.
data/cache/
data/corpus/
data/qdrant/
data/*.sqlite3

# Model caches
.cache/
.hf_cache/

# Notebooks
.ipynb_checkpoints/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Claude Code local settings (machine-specific, auto-generated permission
