# Copy to .env and fill in. See docs/02-data-sources.md "THINGS YOU MUST DO YOURSELF".

# --- Scholarly data sources ---
# Request at https://www.semanticscholar.org/product/api (free; key by email).
# Sent as the x-api-key header. Treat as a secret.
S2_API_KEY=
# Contact email for OpenAlex/Crossref polite pools (sent in User-Agent).
CONTACT_EMAIL=

# --- LLM provider (rag/llm.py — never hardcode a vendor) ---
# ollama (default, local/free) | openai | anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# From a container, point at the host instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vector index ---
# embedded = local on-disk Qdrant, no docker (default for dev).
# server   = the `qdrant` service in docker-compose.yml.
QDRANT_MODE=embedded
QDRANT_PATH=data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=papers

# --- Storage ---
CACHE_DIR=data/cache
SQLITE_PATH=data/rag.sqlite3
DATA_DIR=data
